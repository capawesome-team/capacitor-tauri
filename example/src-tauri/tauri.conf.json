{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capacitor Tauri Example",
  "identifier": "io.capawesome.tauriexample",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Capacitor Tauri Example",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["capacitor-tauri-example"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}

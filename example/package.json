{
  "name": "capacitor-tauri-example",
  "private": true,
  "scripts": {
    "build": "vite build",
    "sync": "cap sync @capawesome/capacitor-tauri",
    "tauri:build": "cd src-tauri && cargo build --release",
    "e2e:prepare": "npm run build && npm run sync && npm run tauri:build",
    "e2e": "wdio run wdio.conf.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/device": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capawesome/capacitor-tauri": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.1",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "@wdio/spec-reporter": "9.29.1"
  }
}
